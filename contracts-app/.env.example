# Copy to .env and fill in ONLY if you want to deploy to the Sepolia testnet.
# Local development (npx hardhat node) needs none of this.

# RPC endpoint. This free public one works; an Alchemy or Infura URL is more reliable.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of a throwaway test wallet holding Sepolia ETH. Never use a wallet with real funds.
SEPOLIA_PRIVATE_KEY=
